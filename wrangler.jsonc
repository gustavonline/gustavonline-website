{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gustavonline-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-14",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "gustavonline.com/notes/*", "zone_name": "gustavonline.com" },
    { "pattern": "www.gustavonline.com/notes/*", "zone_name": "gustavonline.com" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "NEWSLETTER_DRAFTS", "class_name": "NewsletterDrafts" }]
  },
  "migrations": [{ "tag": "newsletter-drafts-v1", "new_sqlite_classes": ["NewsletterDrafts"] }],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://gustavonline.com,https://www.gustavonline.com,http://gustavonline.com,http://www.gustavonline.com,https://gustavonline.github.io,https://onlinesourdough.com,https://www.onlinesourdough.com,https://arcitai.com,https://www.arcitai.com",
    "NOTION_PAPERS_DATA_SOURCE_ID": "ba101532-8866-4388-9597-1d07465e495b",
    "PUBLIC_SITE_URL": "https://gustavonline.com"
  }
}

{
  "name": "gustavonline",
  "version": "1.0.0",
  "description": "Personal website for Gustav Anderson.",
  "type": "module",
  "scripts": {
    "review:build": "VITE_REVIEW_PREVIEW=true vite build --outDir output/family-preview",
    "review:preview": "vite preview --outDir output/family-preview --host 127.0.0.1 --port 4181 --strictPort",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavonline/gustavonline-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gustavonline/gustavonline-website/issues"
  },
  "homepage": "https://gustavonline.com",
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  }
}

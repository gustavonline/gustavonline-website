# Optional Cloudflare Worker endpoints for GitHub Pages deployments.
VITE_WRITING_ENDPOINT=https://gustavonline-api.gustavonline.workers.dev/posts
VITE_NEWSLETTER_ENDPOINT=https://gustavonline-api.gustavonline.workers.dev/newsletter

# Refresh the bundled GitHub snapshot from the public profile README projection.
VITE_GITHUB_PROFILE_REFRESH=true

# Cloudflare Worker secrets set with `npx wrangler secret put ...`.
# KIT_API_KEY=
# NOTION_TOKEN=
